<%- include('../layouts/header', { pageTitle: 'Admin - Coupons' }) %>
<%- include('../layouts/navbar') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
    <div>
      <h2 class="fw-bold text-white mb-1"><i class="bi bi-ticket-perforated me-2 text-cyan"></i> Coupon & Promo Code Manager</h2>
      <p class="text-secondary small mb-0">Create percentage or fixed discount promo codes for storefront marketing</p>
    </div>
  </div>

  <% if (success) { %>
    <div class="alert alert-success border-success small mb-4">
      <i class="bi bi-check-circle-fill me-1"></i> <%= success %>
    </div>
  <% } %>

  <div class="row g-4">
    <!-- Add Coupon Form -->
    <div class="col-lg-4">
      <div class="card card-gaming p-4">
        <h5 class="fw-bold text-white mb-3"><i class="bi bi-plus-circle me-1 text-cyan"></i> Create Promo Code</h5>
        <form action="/admin/coupons" method="POST">
          <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Coupon Code (Uppercase)</label>
            <input type="text" name="code" class="form-control form-control-dark text-uppercase" placeholder="e.g. GAMER20" required>
          </div>
          <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Discount Percentage (%)</label>
            <input type="number" step="1" name="discount_percent" class="form-control form-control-dark" placeholder="10" value="10">
          </div>
          <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Discount Fixed Amount ($)</label>
            <input type="number" step="0.01" name="discount_fixed" class="form-control form-control-dark" placeholder="0.00" value="0.00">
          </div>
          <div class="mb-4">
            <label class="form-label text-muted small fw-bold">Max Uses Limit</label>
            <input type="number" name="max_uses" class="form-control form-control-dark" placeholder="100" value="100">
          </div>
          <div class="d-grid">
            <button type="submit" class="btn btn-gaming">Create Coupon</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Coupons List Table -->
    <div class="col-lg-8">
      <div class="card card-gaming p-4">
        <h5 class="fw-bold text-white mb-3">Active & Archived Coupons</h5>
        <div class="table-responsive">
          <table class="table table-dark table-dark-custom align-middle mb-0">
            <thead>
              <tr class="text-muted small">
                <th>Code</th>
                <th>Discount</th>
                <th>Usage Count</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% coupons.forEach(c => { %>
                <tr>
                  <td><code class="text-cyan font-monospace fs-6"><%= c.code %></code></td>
                  <td class="fw-bold text-white">
                    <%= c.discount_percent > 0 ? c.discount_percent + '% OFF' : '$' + c.discount_fixed.toFixed(2) + ' OFF' %>
                  </td>
                  <td class="small text-secondary"><%= c.times_used %> / <%= c.max_uses %> uses</td>
                  <td>
                    <form action="/admin/coupons/toggle/<%= c.id %>" method="POST" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-outline-<%= c.active ? 'success' : 'secondary' %>">
                        <%= c.active ? 'ACTIVE' : 'DISABLED' %>
                      </button>
                    </form>
                  </td>
                  <td class="text-end">
                    <form action="/admin/coupons/delete/<%= c.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete coupon <%= c.code %>?');">
                      <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
