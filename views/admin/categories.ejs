<%- include('../layouts/header', { pageTitle: 'Admin - Categories' }) %>
<%- include('../layouts/navbar') %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary">
    <div>
      <h2 class="fw-bold text-white mb-1"><i class="bi bi-tags me-2 text-cyan"></i> Game Category Manager</h2>
      <p class="text-secondary small mb-0">Organize storefront game titles, icons, and descriptions</p>
    </div>
  </div>

  <!-- Admin Subnav -->
  <div class="nav nav-pills gap-2 mb-4 bg-card p-2 rounded-3 border border-secondary">
    <a href="/admin" class="nav-link text-white"><i class="bi bi-bar-chart-fill me-1"></i> Overview</a>
    <a href="/admin/products" class="nav-link text-white"><i class="bi bi-box-seam me-1"></i> Products</a>
    <a href="/admin/categories" class="nav-link active"><i class="bi bi-tags me-1"></i> Categories</a>
    <a href="/admin/keys" class="nav-link text-white"><i class="bi bi-key me-1"></i> Key Pools</a>
    <a href="/admin/orders" class="nav-link text-white"><i class="bi bi-receipt me-1"></i> Orders</a>
    <a href="/admin/coupons" class="nav-link text-white"><i class="bi bi-ticket-perforated me-1"></i> Coupons</a>
    <a href="/admin/users" class="nav-link text-white"><i class="bi bi-people me-1"></i> Users</a>
    <a href="/admin/settings" class="nav-link text-white"><i class="bi bi-gear me-1"></i> Store Settings</a>
  </div>

  <% if (success) { %>
    <div class="alert alert-success border-success small mb-4">
      <i class="bi bi-check-circle-fill me-1"></i> <%= success %>
    </div>
  <% } %>

  <div class="row g-4">
    <!-- Add Category Form -->
    <div class="col-lg-4">
      <div class="card card-gaming p-4">
        <h5 class="fw-bold text-white mb-3"><i class="bi bi-plus-circle me-1 text-cyan"></i> Add New Category</h5>
        <form action="/admin/categories" method="POST">
          <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Game Title Name</label>
            <input type="text" name="name" class="form-control form-control-dark" placeholder="e.g. Apex Legends" required>
          </div>
          <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Bootstrap Icon Class</label>
            <input type="text" name="icon" class="form-control form-control-dark" placeholder="bi-controller" value="bi-controller">
          </div>
          <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Short Description</label>
            <textarea name="description" class="form-control form-control-dark" rows="3" placeholder="Skins, Apex Coins..."></textarea>
          </div>
          <div class="d-grid">
            <button type="submit" class="btn btn-gaming">Add Category</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Category List Table -->
    <div class="col-lg-8">
      <div class="card card-gaming p-4">
        <h5 class="fw-bold text-white mb-3">Existing Categories</h5>
        <div class="table-responsive">
          <table class="table table-dark table-dark-custom align-middle mb-0">
            <thead>
              <tr class="text-muted small">
                <th>Icon</th>
                <th>Category Name</th>
                <th>Slug</th>
                <th>Products</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% categories.forEach(c => { %>
                <tr>
                  <td class="text-cyan fs-4"><i class="bi <%= c.icon %>"></i></td>
                  <td class="fw-bold text-white"><%= c.name %></td>
                  <td class="font-monospace small text-secondary"><%= c.slug %></td>
                  <td><span class="badge bg-secondary"><%= c.product_count %> items</span></td>
                  <td class="text-end">
                    <form action="/admin/categories/delete/<%= c.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete category <%= c.name %>?');">
                      <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
