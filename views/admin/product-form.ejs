<%- include('../layouts/header', { pageTitle: product ? 'Edit Product' : 'New Product' }) %>
<%- include('../layouts/navbar') %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-white mb-0">
          <i class="bi bi-pencil-square text-cyan me-2"></i> <%= product && product.id ? 'Edit Product' : 'Add New Game Item' %>
        </h2>
        <a href="/admin/products" class="btn btn-outline-gaming"><i class="bi bi-arrow-left me-1"></i> Back to Products</a>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger border-danger small mb-4">
          <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
        </div>
      <% } %>

      <div class="card card-gaming p-4 p-md-5">
        <form action="<%= product && product.id ? '/admin/products/edit/' + product.id : '/admin/products/new' %>" method="POST">
          <div class="row g-3 mb-3">
            <div class="col-md-8">
              <label class="form-label text-muted small fw-bold">Product / Item Title</label>
              <input type="text" name="name" class="form-control form-control-dark" placeholder="e.g., AWP | Dragon Lore (Factory New)" value="<%= product ? product.name : '' %>" required>
            </div>
            <div class="col-md-4">
              <label class="form-label text-muted small fw-bold">Category</label>
              <select name="category_id" class="form-select form-select-dark" required>
                <% categories.forEach(c => { %>
                  <option value="<%= c.id %>" <%= product && product.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label text-muted small fw-bold">Price ($ USD)</label>
              <input type="number" step="0.01" name="price" class="form-control form-control-dark" placeholder="49.99" value="<%= product ? product.price : '' %>" required>
            </div>
            <div class="col-md-4">
              <label class="form-label text-muted small fw-bold">Rarity Tier</label>
              <select name="rarity" class="form-select form-select-dark">
                <option value="Legendary" <%= product && product.rarity === 'Legendary' ? 'selected' : '' %>>Legendary</option>
                <option value="Epic" <%= product && product.rarity === 'Epic' ? 'selected' : '' %>>Epic</option>
                <option value="Rare" <%= product && product.rarity === 'Rare' ? 'selected' : '' %>>Rare</option>
                <option value="Common" <%= product && product.rarity === 'Common' ? 'selected' : '' %>>Common</option>
              </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
              <div class="form-check form-switch mb-2 ms-2">
                <input class="form-check-input" type="checkbox" name="featured" id="featuredCheck" <%= product && product.featured ? 'checked' : '' %>>
                <label class="form-check-input-label text-white fw-bold ms-2" for="featuredCheck">Feature on Homepage</label>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Image URL</label>
            <input type="url" name="image_url" class="form-control form-control-dark" placeholder="https://images.unsplash.com/..." value="<%= product ? product.image_url : '' %>">
          </div>

          <div class="mb-4">
            <label class="form-label text-muted small fw-bold">Description & Redemption Instructions</label>
            <textarea name="description" class="form-control form-control-dark" rows="4" placeholder="Describe the item float, server region, and how customer redeems the key code..."><%= product ? product.description : '' %></textarea>
          </div>

          <% if (!product || !product.id) { %>
            <div class="mb-4">
              <label class="form-label text-cyan small fw-bold"><i class="bi bi-key-fill me-1"></i> Initial Digital Keys Upload (Optional)</label>
              <textarea name="initial_keys" class="form-control form-control-dark font-monospace" rows="4" placeholder="Paste line-by-line digital license keys or gift codes:&#10;CS2-ABCD-1234-KEY1&#10;CS2-ABCD-1234-KEY2"></textarea>
              <div class="form-text text-secondary small">Each non-empty line will be inserted as an available unused key in the stock pool.</div>
            </div>
          <% } %>

          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-gaming btn-lg">
              <i class="bi bi-check-lg me-1"></i> <%= product && product.id ? 'Save Changes' : 'Create Product' %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
