<%- include('../layouts/header', { pageTitle: 'Create Account' }) %>
<%- include('../layouts/navbar') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card card-gaming p-4 p-md-5">
        <div class="text-center mb-4">
          <i class="bi bi-shield-lock text-cyan" style="font-size: 3rem;"></i>
          <h3 class="fw-bold text-white mt-2">Create Account</h3>
          <p class="text-secondary small">Join LootVault to manage digital item purchases</p>
        </div>

        <% if (error) { %>
          <div class="alert alert-danger border-danger small text-center mb-4">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= error %>
          </div>
        <% } %>

        <form action="/auth/register" method="POST">
          <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Gamer Username</label>
            <input type="text" name="username" class="form-control form-control-dark" placeholder="GamerTag99" required>
          </div>

          <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Email Address</label>
            <input type="email" name="email" class="form-control form-control-dark" placeholder="gamer@example.com" required>
          </div>

          <div class="mb-3">
            <label class="form-label text-muted small fw-bold">Password</label>
            <input type="password" name="password" class="form-control form-control-dark" placeholder="At least 6 characters" required>
          </div>

          <div class="mb-4">
            <label class="form-label text-muted small fw-bold">Confirm Password</label>
            <input type="password" name="confirmPassword" class="form-control form-control-dark" placeholder="Re-enter password" required>
          </div>

          <div class="d-grid mb-4">
            <button type="submit" class="btn btn-gaming btn-lg">Create Account</button>
          </div>
        </form>

        <div class="text-center text-secondary small">
          Already have an account? <a href="/auth/login" class="text-cyan text-decoration-none fw-bold">Login Here</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
