<% if (typeof settings !== 'undefined' && settings.banner_message) { %>
  <div class="top-announcement">
    <i class="bi bi-fire me-1"></i> <%= settings.banner_message %>
  </div>
<% } %>

<nav class="navbar navbar-expand-lg navbar-dark navbar-gaming sticky-top">
  <div class="container-fluid px-lg-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <i class="bi bi-controller text-cyan" style="font-size: 1.6rem;"></i>
      <span class="fw-bold text-white"><%= settings && settings.site_name ? settings.site_name : 'LOOTVAULT' %></span>
    </a>

    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link fw-semibold" href="/"><i class="bi bi-house-door me-1"></i> Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link fw-semibold" href="/catalog"><i class="bi bi-grid-fill me-1"></i> Storefront Catalog</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
            <i class="bi bi-controller me-1"></i> Games
          </a>
          <ul class="dropdown-menu dropdown-menu-dark bg-card border-secondary">
            <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
              <% categories.forEach(c => { %>
                <li><a class="dropdown-item" href="/catalog?category=<%= c.slug %>"><i class="bi <%= c.icon || 'bi-controller' %> me-2 text-cyan"></i> <%= c.name %></a></li>
              <% }); %>
            <% } else { %>
              <li><a class="dropdown-item" href="/catalog"><i class="bi bi-controller me-2"></i> All Games</a></li>
            <% } %>
          </ul>
        </li>
      </ul>

      <!-- Search bar -->
      <form class="d-flex me-lg-3 my-2 my-lg-0" action="/catalog" method="GET">
        <div class="input-group input-group-sm">
          <input class="form-control form-control-dark" type="search" name="search" placeholder="Search CS2, Robux, Gold..." aria-label="Search">
          <button class="btn btn-outline-gaming" type="submit"><i class="bi bi-search"></i></button>
        </div>
      </form>

      <!-- Account & Cart Actions -->
      <div class="d-flex align-items-center gap-2">
        <a href="/cart" class="btn btn-outline-gaming position-relative me-1">
          <i class="bi bi-bag-fill"></i> Cart
          <span id="cartBadgeCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">0</span>
        </a>

        <% if (user) { %>
          <div class="dropdown">
            <button class="btn btn-outline-gaming dropdown-toggle d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle text-cyan"></i> <%= user.username %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark bg-card border-secondary">
              <li><a class="dropdown-item" href="/user/inventory"><i class="bi bi-key-fill me-2 text-warning"></i> My Purchased Keys Vault</a></li>
              <% if (user.role === 'admin') { %>
                <li><hr class="dropdown-divider border-secondary"></li>
                <li><a class="dropdown-item text-cyan fw-bold" href="/admin"><i class="bi bi-speedometer2 me-2"></i> Admin Control Panel</a></li>
              <% } %>
              <li><hr class="dropdown-divider border-secondary"></li>
              <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
            </ul>
          </div>
        <% } else { %>
          <a href="/auth/login" class="btn btn-outline-gaming">Login</a>
          <a href="/auth/register" class="btn btn-gaming">Register</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
