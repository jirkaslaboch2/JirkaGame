<%- include('../layouts/header', { pageTitle: product.name }) %>
<%- include('../layouts/navbar') %>

<div class="container py-5">
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/catalog" class="text-secondary text-decoration-none">Catalog</a></li>
      <li class="breadcrumb-item"><a href="/catalog?category=<%= product.category_slug %>" class="text-secondary text-decoration-none"><%= product.category_name %></a></li>
      <li class="breadcrumb-item active text-white" aria-current="page"><%= product.name %></li>
    </ol>
  </nav>

  <div class="row g-5">
    <!-- Image Gallery -->
    <div class="col-lg-6">
      <div class="card card-gaming p-3 text-center position-relative">
        <img src="<%= product.image_url %>" alt="<%= product.name %>" class="img-fluid rounded-3" style="max-height: 420px; object-fit: cover; width: 100%;">
        <span class="rarity-badge rarity-<%= product.rarity.toLowerCase() %>"><%= product.rarity %> Item</span>
      </div>
    </div>

    <!-- Details -->
    <div class="col-lg-6">
      <div class="badge bg-secondary bg-opacity-25 text-cyan border border-info mb-2">
        <i class="bi bi-tag-fill me-1"></i> <%= product.category_name %>
      </div>
      <h1 class="fw-bold text-white mb-3"><%= product.name %></h1>

      <div class="d-flex align-items-center gap-3 mb-4">
        <span class="fs-2 fw-extrabold text-cyan">$<%= product.price.toFixed(2) %></span>
        
        <% if (product.stock > 0) { %>
          <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-2">
            <i class="bi bi-check-circle-fill me-1"></i> In Stock (<%= product.stock %> Available Keys)
          </span>
        <% } else { %>
          <span class="badge bg-danger bg-opacity-25 text-danger border border-danger px-3 py-2">
            <i class="bi bi-x-circle-fill me-1"></i> Out of Stock
          </span>
        <% } %>
      </div>

      <p class="lead text-secondary mb-4 fs-6">
        <%= product.description %>
      </p>

      <div class="card card-gaming p-3 mb-4 bg-dark">
        <div class="d-flex align-items-center gap-3 mb-2">
          <i class="bi bi-shield-lock-fill text-cyan fs-4"></i>
          <div>
            <div class="fw-bold text-white">Automated Key Delivery</div>
            <div class="small text-secondary">Your unique key code will be revealed instantly upon payment completion.</div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="d-flex gap-3 mb-4">
        <button class="btn btn-gaming btn-lg flex-grow-1" 
                onclick='addToCart(<%- JSON.stringify({ id: product.id, name: product.name, price: product.price, image_url: product.image_url, rarity: product.rarity }) %>)'>
          <i class="bi bi-cart-plus-fill me-2"></i> Add to Cart
        </button>
        <button class="btn btn-neon-purple btn-lg" 
                onclick='addToCart(<%- JSON.stringify({ id: product.id, name: product.name, price: product.price, image_url: product.image_url, rarity: product.rarity }) %>); window.location.href="/cart";'>
          <i class="bi bi-lightning-fill me-2"></i> Buy Now
        </button>
      </div>

      <div class="border-top border-secondary pt-4">
        <div class="row g-3 text-secondary small">
          <div class="col-6"><i class="bi bi-check2 text-cyan me-1"></i> Platform: Global Region</div>
          <div class="col-6"><i class="bi bi-check2 text-cyan me-1"></i> Refund Protection: Covered</div>
          <div class="col-6"><i class="bi bi-check2 text-cyan me-1"></i> Support: 24/7 Live Chat</div>
          <div class="col-6"><i class="bi bi-check2 text-cyan me-1"></i> Payment: Stripe & SSL</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Related Products -->
  <% if (relatedProducts.length > 0) { %>
    <div class="mt-5 pt-5 border-top border-secondary">
      <h3 class="fw-bold text-white mb-4"><i class="bi bi-fire text-warning me-2"></i> You Might Also Like</h3>
      <div class="row g-4">
        <% relatedProducts.forEach(prod => { %>
          <div class="col-12 col-sm-6 col-md-3">
            <div class="card card-gaming h-100">
              <div class="product-img-wrapper">
                <img src="<%= prod.image_url %>" alt="<%= prod.name %>">
                <span class="rarity-badge rarity-<%= prod.rarity.toLowerCase() %>"><%= prod.rarity %></span>
              </div>
              <div class="card-body d-flex flex-column">
                <h6 class="card-title fw-bold text-white text-truncate mb-2">
                  <a href="/product/<%= prod.slug %>" class="text-white text-decoration-none"><%= prod.name %></a>
                </h6>
                <div class="d-flex align-items-center justify-content-between mt-auto pt-3 border-top border-secondary">
                  <span class="fs-6 fw-bold text-white">$<%= prod.price.toFixed(2) %></span>
                  <a href="/product/<%= prod.slug %>" class="btn btn-sm btn-outline-gaming">View</a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>

<%- include('../layouts/footer') %>
