<%- include('../layouts/header', { pageTitle: 'Shopping Cart' }) %>
<%- include('../layouts/navbar') %>

<div class="container py-5">
  <h2 class="fw-bold text-white mb-4"><i class="bi bi-bag-fill me-2 text-cyan"></i> Your Shopping Cart</h2>

  <div class="row g-4">
    <!-- Cart Items List -->
    <div class="col-lg-8" id="cartItemsList">
      <!-- Populated via cart.js -->
    </div>

    <!-- Summary Sidebar -->
    <div class="col-lg-4">
      <div class="card card-gaming p-4 sticky-top" style="top: 90px;">
        <h5 class="fw-bold text-white mb-3">Order Summary</h5>

        <!-- Customer Email Input -->
        <div class="mb-3">
          <label class="form-label text-muted small fw-bold">Delivery Email Address</label>
          <input type="email" id="customerEmailInput" class="form-control form-control-dark" 
                 placeholder="name@example.com" value="<%= user ? user.email : '' %>" required>
          <div class="form-text text-secondary small">Purchased digital keys will be attached to this email.</div>
        </div>

        <!-- Coupon Input -->
        <div class="mb-4">
          <label class="form-label text-muted small fw-bold">Promo / Coupon Code</label>
          <div class="input-group input-group-sm">
            <input type="text" id="couponInput" class="form-control form-control-dark text-uppercase" placeholder="Try GAMER10">
            <button class="btn btn-outline-gaming" type="button" onclick="applyCouponCode()">Apply</button>
          </div>
          <div id="couponMsg"></div>
        </div>

        <div class="border-top border-secondary pt-3 mb-3 d-grid gap-2">
          <div class="d-flex justify-content-between text-secondary">
            <span>Subtotal</span>
            <span id="cartSubtotal" class="fw-bold text-white">$0.00</span>
          </div>
          <div class="d-flex justify-content-between text-success">
            <span>Discount</span>
            <span id="cartDiscount" class="fw-bold">-$0.00</span>
          </div>
          <hr class="border-secondary my-1">
          <div class="d-flex justify-content-between fs-5 fw-bold text-cyan">
            <span>Total</span>
            <span id="cartTotal">$0.00</span>
          </div>
        </div>

        <!-- Primary Payment Buttons -->
        <div class="d-grid gap-2 mb-3">
          <button id="stripePayBtn" class="btn btn-gaming btn-lg" onclick="processCheckout()">
            <i class="bi bi-stripe me-2"></i> Pay with Stripe
          </button>
        </div>

        <div class="text-center text-secondary small">
          <i class="bi bi-shield-check me-1 text-success"></i> 100% Encrypted Stripe Checkout
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.currencySymbol = "<%= settings && settings.currency_symbol ? settings.currency_symbol : '$' %>";
</script>
<%- include('../layouts/footer') %>
